<?xml version="1.0" encoding="UTF-8"?>
<!--
    Nodes file cho nút giao Bình Phước - TP.HCM
    Gốc tọa độ: Tâm vòng xuyến
    Đơn vị: mét
-->
<nodes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/nodes_file.xsd">

    <!-- ============================================================ -->
    <!-- ĐIỂM ĐẦU/CUỐI CÁC NHÁNH ĐƯỜNG CHÍNH (cách tâm 300m)        -->
    <!-- ============================================================ -->
    <node id="N_in"    x="0"    y="300"   type="priority"/>
    <node id="N_out"   x="-10"  y="300"   type="priority"/>
    <node id="S_in"    x="0"    y="-300"  type="priority"/>
    <node id="S_out"   x="10"   y="-300"  type="priority"/>
    <node id="E_in"    x="300"  y="0"     type="priority"/>
    <node id="E_out"   x="300"  y="10"    type="priority"/>
    <node id="W_in"    x="-300" y="0"     type="priority"/>
    <node id="W_out"   x="-300" y="-10"   type="priority"/>

    <!-- ============================================================ -->
    <!-- VÒNG XUYẾN: 8 node trên vòng tròn bán kính 55m              -->
    <!-- (Vòng xuyến thực tế Ø ~100m)                                -->
    <!-- ============================================================ -->
    <node id="R_N"   x="0"    y="55"   type="priority"/>   <!-- Bắc  -->
    <node id="R_NE"  x="39"   y="39"   type="priority"/>   <!-- Bắc-Đông -->
    <node id="R_E"   x="55"   y="0"    type="priority"/>   <!-- Đông -->
    <node id="R_SE"  x="39"   y="-39"  type="priority"/>   <!-- Nam-Đông -->
    <node id="R_S"   x="0"    y="-55"  type="priority"/>   <!-- Nam  -->
    <node id="R_SW"  x="-39"  y="-39"  type="priority"/>   <!-- Nam-Tây -->
    <node id="R_W"   x="-55"  y="0"    type="priority"/>   <!-- Tây  -->
    <node id="R_NW"  x="-39"  y="39"   type="priority"/>   <!-- Bắc-Tây -->

    <!-- ============================================================ -->
    <!-- CẦU VƯỢT: Điểm xuất phát ramp (cách tâm ~200m)             -->
    <!-- Cầu vượt chạy Đông-Tây, vượt qua vòng xuyến               -->
    <!-- ============================================================ -->
    <!-- Phía TÂY: điểm ramp lên cầu -->
    <node id="FW_ramp_up"   x="-200" y="0"    type="priority"/>
    <!-- Phía TÂY: điểm kết thúc ramp lên (bắt đầu cầu) -->
    <node id="FW_bridge"    x="-160" y="0"    type="priority"/>
    <!-- Giữa cầu (trên vòng xuyến) -->
    <node id="F_mid"        x="0"    y="0"    type="priority"/>
    <!-- Phía ĐÔNG: điểm kết thúc cầu -->
    <node id="FE_bridge"    x="160"  y="0"    type="priority"/>
    <!-- Phía ĐÔNG: điểm ramp xuống -->
    <node id="FE_ramp_down" x="200"  y="0"    type="priority"/>

    <!-- ============================================================ -->
    <!-- HẦM CHUI: Điểm vào/ra hầm (cách tâm ~100m)                 -->
    <!-- Hầm chạy Bắc-Nam, đi dưới vòng xuyến                      -->
    <!-- ============================================================ -->
    <!-- Phía BẮC: điểm vào hầm -->
    <node id="TN_entry"  x="5"   y="100"   type="priority"/>
    <!-- Phía BẮC: điểm ra hầm -->
    <node id="TN_exit"   x="5"   y="-100"  type="priority"/>
    <!-- Phía NAM: điểm vào hầm -->
    <node id="TS_entry"  x="-5"  y="-100"  type="priority"/>
    <!-- Phía NAM: điểm ra hầm -->
    <node id="TS_exit"   x="-5"  y="100"   type="priority"/>

</nodes>
