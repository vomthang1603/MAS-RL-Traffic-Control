<?xml version="1.0" encoding="UTF-8"?>
<!--
    Edges file cho nút giao Bình Phước - TP.HCM
    Tốc độ (m/s): 50km/h=13.89  |  60km/h=16.67  |  30km/h=8.33
-->
<edges xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/edges_file.xsd">

    <!-- ============================================================ -->
    <!-- 1. ĐƯỜNG TIẾP CẬN MẶT ĐẤT (Ground approach - 50 km/h)      -->
    <!-- ============================================================ -->

    <!-- Hướng BẮC vào vòng xuyến -->
    <edge id="N_to_RN"   from="N_in"   to="R_N"   numLanes="3" speed="13.89" priority="12" spreadType="center"/>
    <!-- Hướng BẮC ra khỏi vòng xuyến -->
    <edge id="RN_to_N"   from="R_N"    to="N_out"  numLanes="3" speed="13.89" priority="12" spreadType="center"/>

    <!-- Hướng NAM vào vòng xuyến -->
    <edge id="S_to_RS"   from="S_in"   to="R_S"   numLanes="3" speed="13.89" priority="12" spreadType="center"/>
    <!-- Hướng NAM ra khỏi vòng xuyến -->
    <edge id="RS_to_S"   from="R_S"    to="S_out"  numLanes="3" speed="13.89" priority="12" spreadType="center"/>

    <!-- Hướng ĐÔNG vào vòng xuyến (mặt đất) -->
    <edge id="E_to_RE"   from="E_in"   to="R_E"   numLanes="2" speed="13.89" priority="10" spreadType="center"/>
    <!-- Hướng ĐÔNG ra khỏi vòng xuyến (mặt đất) -->
    <edge id="RE_to_E"   from="R_E"    to="E_out"  numLanes="2" speed="13.89" priority="10" spreadType="center"/>

    <!-- Hướng TÂY vào vòng xuyến (mặt đất) -->
    <edge id="W_to_RW"   from="W_in"   to="R_W"   numLanes="2" speed="13.89" priority="10" spreadType="center"/>
    <!-- Hướng TÂY ra khỏi vòng xuyến (mặt đất) -->
    <edge id="RW_to_W"   from="R_W"    to="W_out"  numLanes="2" speed="13.89" priority="10" spreadType="center"/>

    <!-- ============================================================ -->
    <!-- 2. VÒNG XUYẾN - 1 chiều ngược chiều kim đồng hồ (30 km/h)  -->
    <!-- Thứ tự: N → NW → W → SW → S → SE → E → NE → N              -->
    <!-- ============================================================ -->
    <edge id="rnd_N_NW"  from="R_N"   to="R_NW"  numLanes="2" speed="8.33" priority="11" spreadType="center"
          shape="0,55 -20,52 -39,39"/>
    <edge id="rnd_NW_W"  from="R_NW"  to="R_W"   numLanes="2" speed="8.33" priority="11" spreadType="center"
          shape="-39,39 -52,20 -55,0"/>
    <edge id="rnd_W_SW"  from="R_W"   to="R_SW"  numLanes="2" speed="8.33" priority="11" spreadType="center"
          shape="-55,0 -52,-20 -39,-39"/>
    <edge id="rnd_SW_S"  from="R_SW"  to="R_S"   numLanes="2" speed="8.33" priority="11" spreadType="center"
          shape="-39,-39 -20,-52 0,-55"/>
    <edge id="rnd_S_SE"  from="R_S"   to="R_SE"  numLanes="2" speed="8.33" priority="11" spreadType="center"
          shape="0,-55 20,-52 39,-39"/>
    <edge id="rnd_SE_E"  from="R_SE"  to="R_E"   numLanes="2" speed="8.33" priority="11" spreadType="center"
          shape="39,-39 52,-20 55,0"/>
    <edge id="rnd_E_NE"  from="R_E"   to="R_NE"  numLanes="2" speed="8.33" priority="11" spreadType="center"
          shape="55,0 52,20 39,39"/>
    <edge id="rnd_NE_N"  from="R_NE"  to="R_N"   numLanes="2" speed="8.33" priority="11" spreadType="center"
          shape="39,39 20,52 0,55"/>

    <!-- ============================================================ -->
    <!-- 3. CẦU VƯỢT Đông-Tây (60 km/h, 3 làn mỗi chiều)            -->
    <!-- Hướng TÂY → ĐÔNG                                            -->
    <!-- ============================================================ -->
    <!-- Ramp lên cầu từ đường Tây (W_in → FW_ramp_up → FW_bridge)  -->
    <edge id="W_to_ramp_up"  from="W_in"        to="FW_ramp_up"   numLanes="2" speed="8.33"  priority="9"  spreadType="center"/>
    <edge id="ramp_up_FW"    from="FW_ramp_up"  to="FW_bridge"    numLanes="2" speed="11.11" priority="9"  spreadType="center"/>
    <!-- Đoạn cầu chính Tây → Đông -->
    <edge id="fly_W_to_E"    from="FW_bridge"   to="FE_bridge"    numLanes="3" speed="16.67" priority="14" spreadType="center"
          shape="-160,6 -80,6 0,6 80,6 160,6"/>
    <!-- Ramp xuống phía Đông -->
    <edge id="ramp_down_FE"  from="FE_bridge"   to="FE_ramp_down" numLanes="2" speed="11.11" priority="9"  spreadType="center"/>
    <edge id="FE_to_E_out"   from="FE_ramp_down" to="E_out"       numLanes="2" speed="8.33"  priority="9"  spreadType="center"/>

    <!-- Hướng ĐÔNG → TÂY                                            -->
    <!-- Ramp lên cầu từ đường Đông -->
    <edge id="E_to_ramp_up"  from="E_in"         to="FE_ramp_down" numLanes="2" speed="8.33"  priority="9"  spreadType="center"/>
    <edge id="ramp_up_FE"    from="FE_ramp_down"  to="FE_bridge"   numLanes="2" speed="11.11" priority="9"  spreadType="center"/>
    <!-- Đoạn cầu chính Đông → Tây -->
    <edge id="fly_E_to_W"    from="FE_bridge"    to="FW_bridge"    numLanes="3" speed="16.67" priority="14" spreadType="center"
          shape="160,6 80,6 0,6 -80,6 -160,6"/>
    <!-- Ramp xuống phía Tây -->
    <edge id="ramp_down_FW"  from="FW_bridge"    to="FW_ramp_up"   numLanes="2" speed="11.11" priority="9"  spreadType="center"/>
    <edge id="FW_to_W_out"   from="FW_ramp_up"   to="W_out"        numLanes="2" speed="8.33"  priority="9"  spreadType="center"/>

    <!-- ============================================================ -->
    <!-- 4. HẦM CHUI Bắc-Nam (50 km/h, 2 làn mỗi chiều)             -->
    <!-- Hướng BẮC → NAM                                             -->
    <!-- ============================================================ -->
    <!-- Đường vào hầm phía Bắc -->
    <edge id="N_to_TN"    from="N_in"    to="TN_entry"   numLanes="2" speed="11.11" priority="9"  spreadType="center"/>
    <!-- Đường hầm chính Bắc → Nam -->
    <edge id="tun_N_to_S" from="TN_entry" to="TN_exit"   numLanes="2" speed="13.89" priority="14" spreadType="center"
          shape="5,100 5,50 5,0 5,-50 5,-100"/>
    <!-- Đường ra hầm phía Nam -->
    <edge id="TN_to_S"    from="TN_exit"  to="S_out"     numLanes="2" speed="11.11" priority="9"  spreadType="center"/>

    <!-- Hướng NAM → BẮC                                             -->
    <!-- Đường vào hầm phía Nam -->
    <edge id="S_to_TS"    from="S_in"    to="TS_entry"   numLanes="2" speed="11.11" priority="9"  spreadType="center"/>
    <!-- Đường hầm chính Nam → Bắc -->
    <edge id="tun_S_to_N" from="TS_entry" to="TS_exit"   numLanes="2" speed="13.89" priority="14" spreadType="center"
          shape="-5,-100 -5,-50 -5,0 -5,50 -5,100"/>
    <!-- Đường ra hầm phía Bắc -->
    <edge id="TS_to_N"    from="TS_exit"  to="N_out"     numLanes="2" speed="11.11" priority="9"  spreadType="center"/>

</edges>
