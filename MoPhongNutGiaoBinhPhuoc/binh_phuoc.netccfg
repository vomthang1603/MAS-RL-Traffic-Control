<?xml version="1.0" encoding="UTF-8"?>
<!--
    Netconvert configuration cho nút giao Bình Phước - TP.HCM
    
    Chạy lệnh sau để build file .net.xml:
    
        netconvert -c binh_phuoc.netccfg
    
    Hoặc chạy trực tiếp:
    
        netconvert --node-files=binh_phuoc.nod.xml \
                   --edge-files=binh_phuoc.edg.xml \
                   --connection-files=binh_phuoc.con.xml \
                   --output-file=binh_phuoc.net.xml \
                   --no-turnarounds true \
                   --roundabouts.guess true \
                   --junctions.corner-detail 5 \
                   --verbose
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/netconvertConfiguration.xsd">

    <input>
        <node-files value="binh_phuoc.nod.xml"/>
        <edge-files value="binh_phuoc.edg.xml"/>
        <connection-files value="binh_phuoc.con.xml"/>
    </input>

    <output>
        <output-file value="binh_phuoc.net.xml"/>
        <output.street-names value="true"/>
    </output>

    <processing>
        <!-- Đoán hướng vòng xuyến tự động -->
        <roundabouts.guess value="true"/>
        <!-- Không tạo U-turn tự động -->
        <no-turnarounds value="true"/>
        <!-- Làm mịn góc nút giao -->
        <junctions.corner-detail value="5"/>
        <!-- Tốc độ tối đa khi quẹo -->
        <junctions.limit-turn-speed value="5.5"/>
        <!-- Tối ưu làn -->
        <no-internal-links value="false"/>
    </processing>

    <report>
        <verbose value="true"/>
        <print-options value="true"/>
    </report>

</configuration>
