<?xml version="1.0" encoding="UTF-8"?>
<!--
    Route file mẫu cho mô phỏng nút giao Bình Phước
    Lưu file này là: binh_phuoc.rou.xml
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ============================================================ -->
    <!-- ĐỊNH NGHĨA LOẠI XE                                           -->
    <!-- ============================================================ -->
    <vType id="car"   accel="2.6" decel="4.5" sigma="0.5" length="5"  minGap="2.5" maxSpeed="16.67" guiShape="passenger"/>
    <vType id="bus"   accel="1.2" decel="4.0" sigma="0.5" length="12" minGap="3.0" maxSpeed="13.89" guiShape="bus"/>
    <vType id="moto"  accel="3.0" decel="5.0" sigma="0.7" length="2"  minGap="1.5" maxSpeed="13.89" guiShape="motorcycle"/>

    <!-- ============================================================ -->
    <!-- ROUTES                                                       -->
    <!-- ============================================================ -->

    <!-- === QUA CẦU VƯỢT (Tây → Đông) === -->
    <route id="r_fly_WE" edges="W_to_ramp_up ramp_up_FW fly_W_to_E ramp_down_FE FE_to_E_out"/>

    <!-- === QUA CẦU VƯỢT (Đông → Tây) === -->
    <route id="r_fly_EW" edges="E_to_ramp_up ramp_up_FE fly_E_to_W ramp_down_FW FW_to_W_out"/>

    <!-- === QUA HẦM CHUI (Bắc → Nam) === -->
    <route id="r_tun_NS" edges="N_to_TN tun_N_to_S TN_to_S"/>

    <!-- === QUA HẦM CHUI (Nam → Bắc) === -->
    <route id="r_tun_SN" edges="S_to_TS tun_S_to_N TS_to_N"/>

    <!-- === VÀO VÒNG XUYẾN: Bắc → Đông (rẽ phải) === -->
    <route id="r_N_to_E" edges="N_to_RN rnd_NE_N rnd_N_NW rnd_NW_W rnd_W_SW rnd_SW_S rnd_S_SE rnd_SE_E RE_to_E"/>
    <!-- Đi ngắn hơn qua vòng xuyến: Bắc → Đông (rẽ trái qua R_NE) -->
    <route id="r_N_to_E2" edges="N_to_RN rnd_N_NW rnd_NW_W rnd_W_SW rnd_SW_S rnd_S_SE rnd_SE_E RE_to_E"/>

    <!-- === VÀO VÒNG XUYẾN: Bắc → Nam === -->
    <route id="r_N_to_S" edges="N_to_RN rnd_NE_N rnd_N_NW rnd_NW_W rnd_W_SW rnd_SW_S RS_to_S"/>

    <!-- === VÀO VÒNG XUYẾN: Đông → Bắc === -->
    <route id="r_E_to_N" edges="E_to_RE rnd_E_NE rnd_NE_N RN_to_N"/>

    <!-- === VÀO VÒNG XUYẾN: Nam → Tây === -->
    <route id="r_S_to_W" edges="S_to_RS rnd_S_SE rnd_SE_E rnd_E_NE rnd_NE_N rnd_N_NW rnd_NW_W RW_to_W"/>

    <!-- ============================================================ -->
    <!-- FLOWS (Lưu lượng giao thông theo giờ cao điểm)              -->
    <!-- Thời gian: 0–3600 giây (1 giờ)                              -->
    <!-- ============================================================ -->

    <!-- Cầu vượt: lưu lượng cao (QL13 / Phạm Văn Đồng) -->
    <flow id="f_fly_WE_car"  route="r_fly_WE" type="car"  begin="0" end="3600" vehsPerHour="800"  departLane="best" departSpeed="max"/>
    <flow id="f_fly_WE_bus"  route="r_fly_WE" type="bus"  begin="0" end="3600" vehsPerHour="60"   departLane="best" departSpeed="max"/>
    <flow id="f_fly_EW_car"  route="r_fly_EW" type="car"  begin="0" end="3600" vehsPerHour="800"  departLane="best" departSpeed="max"/>
    <flow id="f_fly_EW_bus"  route="r_fly_EW" type="bus"  begin="0" end="3600" vehsPerHour="60"   departLane="best" departSpeed="max"/>

    <!-- Hầm chui: lưu lượng trung bình (Đinh Bộ Lĩnh / QL1K) -->
    <flow id="f_tun_NS_car"  route="r_tun_NS" type="car"  begin="0" end="3600" vehsPerHour="500"  departLane="best" departSpeed="max"/>
    <flow id="f_tun_NS_moto" route="r_tun_NS" type="moto" begin="0" end="3600" vehsPerHour="1200" departLane="best" departSpeed="max"/>
    <flow id="f_tun_SN_car"  route="r_tun_SN" type="car"  begin="0" end="3600" vehsPerHour="500"  departLane="best" departSpeed="max"/>
    <flow id="f_tun_SN_moto" route="r_tun_SN" type="moto" begin="0" end="3600" vehsPerHour="1200" departLane="best" departSpeed="max"/>

    <!-- Vòng xuyến: xe rẽ các hướng -->
    <flow id="f_N_to_E"   route="r_N_to_E2" type="car"  begin="0" end="3600" vehsPerHour="200"  departLane="best"/>
    <flow id="f_N_to_S"   route="r_N_to_S"  type="car"  begin="0" end="3600" vehsPerHour="150"  departLane="best"/>
    <flow id="f_E_to_N"   route="r_E_to_N"  type="car"  begin="0" end="3600" vehsPerHour="200"  departLane="best"/>
    <flow id="f_S_to_W"   route="r_S_to_W"  type="car"  begin="0" end="3600" vehsPerHour="150"  departLane="best"/>

</routes>
