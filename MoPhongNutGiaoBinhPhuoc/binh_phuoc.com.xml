<?xml version="1.0" encoding="UTF-8"?>
<!--
    Connections file cho nút giao Bình Phước
    Định nghĩa kết nối làn (lane-level) tại mỗi nút
-->
<connections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/connections_file.xsd">

    <!-- ============================================================ -->
    <!-- VÒNG XUYẾN: Xe vào và ra                                     -->
    <!-- ============================================================ -->

    <!-- Vào vòng xuyến từ Bắc -->
    <connection from="N_to_RN"  to="rnd_N_NW"  fromLane="0" toLane="0"/>
    <connection from="N_to_RN"  to="rnd_N_NW"  fromLane="1" toLane="1"/>
    <connection from="N_to_RN"  to="rnd_NE_N"  fromLane="2" toLane="1"/>

    <!-- Ra khỏi vòng xuyến hướng Bắc -->
    <connection from="rnd_NE_N" to="RN_to_N"   fromLane="0" toLane="0"/>
    <connection from="rnd_NE_N" to="RN_to_N"   fromLane="1" toLane="1"/>

    <!-- Vào vòng xuyến từ Nam -->
    <connection from="S_to_RS"  to="rnd_S_SE"  fromLane="0" toLane="0"/>
    <connection from="S_to_RS"  to="rnd_S_SE"  fromLane="1" toLane="1"/>
    <connection from="S_to_RS"  to="rnd_SW_S"  fromLane="2" toLane="1"/>

    <!-- Ra khỏi vòng xuyến hướng Nam -->
    <connection from="rnd_SW_S" to="RS_to_S"   fromLane="0" toLane="0"/>
    <connection from="rnd_SW_S" to="RS_to_S"   fromLane="1" toLane="1"/>

    <!-- Vào vòng xuyến từ Đông -->
    <connection from="E_to_RE"  to="rnd_E_NE"  fromLane="0" toLane="0"/>
    <connection from="E_to_RE"  to="rnd_E_NE"  fromLane="1" toLane="1"/>

    <!-- Ra khỏi vòng xuyến hướng Đông -->
    <connection from="rnd_SE_E" to="RE_to_E"   fromLane="0" toLane="0"/>
    <connection from="rnd_SE_E" to="RE_to_E"   fromLane="1" toLane="1"/>

    <!-- Vào vòng xuyến từ Tây -->
    <connection from="W_to_RW"  to="rnd_W_SW"  fromLane="0" toLane="0"/>
    <connection from="W_to_RW"  to="rnd_W_SW"  fromLane="1" toLane="1"/>

    <!-- Ra khỏi vòng xuyến hướng Tây -->
    <connection from="rnd_NW_W" to="RW_to_W"   fromLane="0" toLane="0"/>
    <connection from="rnd_NW_W" to="RW_to_W"   fromLane="1" toLane="1"/>

    <!-- Vòng xuyến nối tiếp nhau -->
    <connection from="rnd_N_NW"  to="rnd_NW_W"  fromLane="0" toLane="0"/>
    <connection from="rnd_N_NW"  to="rnd_NW_W"  fromLane="1" toLane="1"/>
    <connection from="rnd_NW_W"  to="rnd_W_SW"  fromLane="0" toLane="0"/>
    <connection from="rnd_NW_W"  to="rnd_W_SW"  fromLane="1" toLane="1"/>
    <connection from="rnd_W_SW"  to="rnd_SW_S"  fromLane="0" toLane="0"/>
    <connection from="rnd_W_SW"  to="rnd_SW_S"  fromLane="1" toLane="1"/>
    <connection from="rnd_SW_S"  to="rnd_S_SE"  fromLane="0" toLane="0"/>
    <connection from="rnd_SW_S"  to="rnd_S_SE"  fromLane="1" toLane="1"/>
    <connection from="rnd_S_SE"  to="rnd_SE_E"  fromLane="0" toLane="0"/>
    <connection from="rnd_S_SE"  to="rnd_SE_E"  fromLane="1" toLane="1"/>
    <connection from="rnd_SE_E"  to="rnd_E_NE"  fromLane="0" toLane="0"/>
    <connection from="rnd_SE_E"  to="rnd_E_NE"  fromLane="1" toLane="1"/>
    <connection from="rnd_E_NE"  to="rnd_NE_N"  fromLane="0" toLane="0"/>
    <connection from="rnd_E_NE"  to="rnd_NE_N"  fromLane="1" toLane="1"/>
    <connection from="rnd_NE_N"  to="rnd_N_NW"  fromLane="0" toLane="0"/>
    <connection from="rnd_NE_N"  to="rnd_N_NW"  fromLane="1" toLane="1"/>

    <!-- ============================================================ -->
    <!-- CẦU VƯỢT: Nối tiếp ramp → bridge → ramp                     -->
    <!-- ============================================================ -->

    <!-- Tây → Đông -->
    <connection from="W_to_ramp_up"  to="ramp_up_FW"   fromLane="0" toLane="0"/>
    <connection from="W_to_ramp_up"  to="ramp_up_FW"   fromLane="1" toLane="1"/>
    <connection from="ramp_up_FW"    to="fly_W_to_E"   fromLane="0" toLane="0"/>
    <connection from="ramp_up_FW"    to="fly_W_to_E"   fromLane="1" toLane="1"/>
    <connection from="fly_W_to_E"    to="ramp_down_FE" fromLane="0" toLane="0"/>
    <connection from="fly_W_to_E"    to="ramp_down_FE" fromLane="1" toLane="1"/>
    <connection from="ramp_down_FE"  to="FE_to_E_out"  fromLane="0" toLane="0"/>
    <connection from="ramp_down_FE"  to="FE_to_E_out"  fromLane="1" toLane="1"/>

    <!-- Đông → Tây -->
    <connection from="E_to_ramp_up"  to="ramp_up_FE"   fromLane="0" toLane="0"/>
    <connection from="E_to_ramp_up"  to="ramp_up_FE"   fromLane="1" toLane="1"/>
    <connection from="ramp_up_FE"    to="fly_E_to_W"   fromLane="0" toLane="0"/>
    <connection from="ramp_up_FE"    to="fly_E_to_W"   fromLane="1" toLane="1"/>
    <connection from="fly_E_to_W"    to="ramp_down_FW" fromLane="0" toLane="0"/>
    <connection from="fly_E_to_W"    to="ramp_down_FW" fromLane="1" toLane="1"/>
    <connection from="ramp_down_FW"  to="FW_to_W_out"  fromLane="0" toLane="0"/>
    <connection from="ramp_down_FW"  to="FW_to_W_out"  fromLane="1" toLane="1"/>

    <!-- ============================================================ -->
    <!-- HẦM CHUI: Nối tiếp đường vào → hầm → đường ra              -->
    <!-- ============================================================ -->

    <!-- Bắc → Nam -->
    <connection from="N_to_TN"    to="tun_N_to_S" fromLane="0" toLane="0"/>
    <connection from="N_to_TN"    to="tun_N_to_S" fromLane="1" toLane="1"/>
    <connection from="tun_N_to_S" to="TN_to_S"    fromLane="0" toLane="0"/>
    <connection from="tun_N_to_S" to="TN_to_S"    fromLane="1" toLane="1"/>

    <!-- Nam → Bắc -->
    <connection from="S_to_TS"    to="tun_S_to_N" fromLane="0" toLane="0"/>
    <connection from="S_to_TS"    to="tun_S_to_N" fromLane="1" toLane="1"/>
    <connection from="tun_S_to_N" to="TS_to_N"    fromLane="0" toLane="0"/>
    <connection from="tun_S_to_N" to="TS_to_N"    fromLane="1" toLane="1"/>

</connections>
