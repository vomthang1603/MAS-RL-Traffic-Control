<?xml version="1.0" encoding="UTF-8"?>
<!--
    SUMO Simulation Configuration: Nút giao Bình Phước - TP.HCM
    
    Chạy mô phỏng:
        sumo-gui -c binh_phuoc.sumocfg
    
    Hoặc không GUI:
        sumo -c binh_phuoc.sumocfg
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="binh_phuoc.net.xml"/>
        <route-files value="binh_phuoc.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.1"/>
    </time>

    <processing>
        <ignore-route-errors value="true"/>
        <collision.action value="warn"/>
        <time-to-teleport value="300"/>
    </processing>

    <output>
        <!-- Thống kê tóm tắt -->
        <summary-output value="binh_phuoc_summary.xml"/>
        <!-- Lưu lượng mỗi làn đường -->
        <lanedata-output value="binh_phuoc_lanedata.xml"/>
        <!-- Thống kê phương tiện -->
        <tripinfo-output value="binh_phuoc_tripinfo.xml"/>
    </output>

    <report>
        <verbose value="true"/>
        <no-step-log value="false"/>
    </report>

</configuration>
